{
  "name": "gym-tracker-server",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:admin": "vite --config admin-web/vite.config.ts",
    "build:server": "tsc",
    "build:admin": "vite build --config admin-web/vite.config.ts",
    "build": "tsc && vite build --config admin-web/vite.config.ts",
    "start": "node dist/index.js",
    "pack:docker": "pnpm run build && cd .. && rm -f gym-tracker-server-docker.tar.gz && tar --exclude='server/node_modules' --exclude='server/data/*.db*' --exclude='server/.DS_Store' -czvf gym-tracker-server-docker.tar.gz -s '/^server/gym-tracker-server/' server"

  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.4"
  }
}
